; $VER: Install-CrispyDoom 7.2-amiga4-rc1 (17.11.2026)
; The Amiga Installer script for Crispy Doom, an AmiCradle game port.
; Made by amicradle scripts/ports/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the CrispyDoom drawer where the archive was unpacked.

(set @app-name "Crispy Doom")
(set #version "7.2-amiga4-rc1")
(set #drawer "CrispyDoom")
(set #program "crispy-doom")
(set #space 3907)  ; KB

(onerror
    (message (cat "Crispy Doom was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-CrispyDoom again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "Crispy Doom needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "Crispy Doom needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "Crispy Doom needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The CrispyDoom drawer is not beside Install-CrispyDoom. Unpack the whole archive, then run Install-CrispyDoom from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The CrispyDoom drawer has no crispy-doom in it. Unpack the whole archive again."))

(welcome "This installs Crispy Doom 7.2-amiga4-rc1 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the CrispyDoom drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called CrispyDoom in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": Crispy Doom needs 4 MB free.")))

; GFOpenGPU's modules: in LIBS:GFOpenGPU/, or copied there from LIBS:OpenGPU/
; (older instances have only that); none is copied before all are found
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2.module" (noreq)) 1))
    (abort "Crispy Doom needs GFOpenGPU's SDL2.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-CrispyDoom again. Nothing has been installed."))
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2_mixer.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2_mixer.module" (noreq)) 1))
    (abort "Crispy Doom needs GFOpenGPU's SDL2_mixer.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-CrispyDoom again. Nothing has been installed."))
(if (<> (exists "LIBS:GFOpenGPU" (noreq)) 2)
    (makedir "LIBS:GFOpenGPU"))
(if (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying SDL2.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "SDL2.module")))
(if (<> (exists "LIBS:GFOpenGPU/SDL2_mixer.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying SDL2_mixer.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "SDL2_mixer.module")))
(complete 20)

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "User") (noreq))
    (set #kept (if (= #kept "") "User" (cat #kept "|" "User"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying Crispy Doom")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating Crispy Doom. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "CrispyDoom.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "CrispyDoom.info")))

(set #later "")

; the game data the drawer does not carry: downloaded with C:Atlas, or copied from
; the player's own drawer, disk or CD; each file's SHA-256 checked where the spec names it
(set #atlas (= (exists "C:Atlas" (noreq)) 1))

; Freedoom, the free Doom data
(set #into1 #dest)
(if (<> (exists #into1 (noreq)) 2) (makedir #into1))
(set #have (and (= (exists (tackon #into1 "freedoom1.wad") (noreq)) 1) (= (exists (tackon #into1 "freedoom2.wad") (noreq)) 1)))
(if (not #have)
    (
        (set #how
            (askchoice
                (prompt "Crispy Doom needs Freedoom, the free Doom data. How should the Installer get it?")
                (help "Crispy Doom needs Freedoom, the free Doom data: freedoom1.wad, freedoom2.wad, in the drawer itself. Download fetches freedoom-0.13.0.zip from https://github.com/freedoom/freedoom/releases/download/v0.13.0/freedoom-0.13.0.zip with C:Atlas (AmiPortAtlas) and checks its SHA-256. The files come from https://freedoom.github.io. Not now leaves the drawer as it is: run the Installer again later, or copy the files in yourself.")
                (choices "Download it now (24 MB, needs the network)" "Not now: the game starts without it")
                (default 0)))
        (if (and (= #how 0) (not #atlas))
            (
                (message "C:Atlas, which downloads it, is not on this Amiga: install AmiPortAtlas (its C/Atlas goes in C:). Then run Install-CrispyDoom again.")
                (set #how 1)
            )
        )
        (if (= #how 0)
            (
                (set #arc1 (tackon #dest "freedoom-0.13.0.zip"))
                (working "Downloading freedoom-0.13.0.zip for Freedoom, the free Doom data.")
                (set #rc 0)
                (if (not @pretend)
                    (set #rc (run (cat "C:Atlas FETCH URL=\"https://github.com/freedoom/freedoom/releases/download/v0.13.0/freedoom-0.13.0.zip\" TO=\"" #arc1 "\" SHA256=3f9b264f3e3ce503b4fb7f6bdcb1f419d93c7b546f4df3e874dd878db9688f59"))))
                (if (<> #rc 0)
                    (
                        (message "The download of freedoom-0.13.0.zip did not complete or did not check out. Crispy Doom is installed without Freedoom, the free Doom data: run Install-CrispyDoom again to try once more.")
                        (set #how 1)
                    )
                )
                (if (and (= #how 0) (<> (exists "SYS:Utilities/GFOpenCompress" (noreq)) 1))
                    (
                        (message "SYS:Utilities/GFOpenCompress, which unpacks freedoom-0.13.0.zip, is not on this Amiga. It is left in the drawer: unpack it there yourself.")
                        (set #how 1)
                    )
                )
                (if (= #how 0)
                    (
                        (set #unpack (tackon #dest "Unpack"))
                        (if (= (exists #unpack (noreq)) 2) (delete #unpack (all) (optional "force")))
                        (makedir #unpack)
                        (working "Unpacking freedoom-0.13.0.zip.")
                        (if (not @pretend) (run (cat "SYS:Utilities/GFOpenCompress x \"" #arc1 "\" \"" #unpack "\" >NIL:")))
                        (copyfiles
                            (prompt "Copying Freedoom, the free Doom data")
                            (help @copyfiles-help)
                            (source (tackon #unpack "freedoom-0.13.0"))
                            (dest #into1)
                            (choices "freedoom1.wad" "freedoom2.wad")
                            (optional "nofail" "force"))
                        (delete #unpack (all) (optional "force"))
                        (delete #arc1 (optional "force"))
                    )
                )
            )
        )
        (if (= #how 1)
            (set #later (if (= #later "") "Freedoom, the free Doom data" (cat #later ", " "Freedoom, the free Doom data")))
        )
    )
)

; your own Doom IWAD
(set #into2 #dest)
(if (<> (exists #into2 (noreq)) 2) (makedir #into2))
(set #have (or (= (exists (tackon #into2 "doom1.wad") (noreq)) 1) (= (exists (tackon #into2 "doom.wad") (noreq)) 1) (= (exists (tackon #into2 "doom2.wad") (noreq)) 1) (= (exists (tackon #into2 "tnt.wad") (noreq)) 1) (= (exists (tackon #into2 "plutonia.wad") (noreq)) 1)))
(if (not #have)
    (
        (set #how
            (askchoice
                (prompt "Crispy Doom needs your own Doom IWAD. How should the Installer get it?")
                (help "Crispy Doom needs your own Doom IWAD: one of doom1.wad, doom.wad, doom2.wad, tnt.wad, plutonia.wad, in the drawer itself. Copy takes the files from a drawer you choose: the game's own install, a disk or a CD. Not now leaves the drawer as it is: run the Installer again later, or copy the files in yourself.")
                (choices "Copy it from my own drawer, disk or CD" "Not now: the game starts without it")
                (default 0)))
        (if (= #how 0)
            (
                (set #src
                    (askdir
                        (prompt "Choose the drawer (or disk, or CD) that has one of doom1.wad, doom.wad, doom2.wad, tnt.wad, plutonia.wad.")
                        (help "Crispy Doom needs your own Doom IWAD: one of doom1.wad, doom.wad, doom2.wad, tnt.wad, plutonia.wad, in the drawer itself. Copy takes the files from a drawer you choose: the game's own install, a disk or a CD. Not now leaves the drawer as it is: run the Installer again later, or copy the files in yourself.")
                        (default #dest)))
                (set #ok 1)
                (if (and #ok (not (or (= (exists (tackon #src "doom1.wad") (noreq)) 1) (= (exists (tackon #src "doom.wad") (noreq)) 1) (= (exists (tackon #src "doom2.wad") (noreq)) 1) (= (exists (tackon #src "tnt.wad") (noreq)) 1) (= (exists (tackon #src "plutonia.wad") (noreq)) 1))))
                    ((set #ok 0) (message (cat "There is none of doom1.wad, doom.wad, doom2.wad, tnt.wad, plutonia.wad in " #src ". Nothing was copied for your own Doom IWAD."))))
                (if #ok
                    (copyfiles
                        (prompt "Copying your own Doom IWAD")
                        (help @copyfiles-help)
                        (source #src)
                        (dest #into2)
                        (choices "doom1.wad" "doom.wad" "doom2.wad" "tnt.wad" "plutonia.wad")
                        (optional "nofail" "force")))
            )
        )
        (if (= #how 1)
            (set #later (if (= #later "") "your own Doom IWAD" (cat #later ", " "your own Doom IWAD")))
        )
    )
)
(complete 90)

(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. Crispy Doom would have gone in " #dest "."))
    (message (cat "Crispy Doom 7.2-amiga4-rc1 is installed in " #dest "."
                  "\n\nTo start it, open the CrispyDoom drawer and double-click the crispy-doom icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept "."))
                  (if (= #later "") "" (cat "\n\nStill to add to the drawer: " #later ". Run Install-CrispyDoom again to fetch or copy it.")))))
(exit (quiet))
